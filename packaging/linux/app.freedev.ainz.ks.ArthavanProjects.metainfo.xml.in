<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>app.freedev.ainz.ks.ArthavanProjects</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Arthavan Projects</name>
  <summary>Install, update and launch the Craft App Suite</summary>
  <developer id="app.freedev.ainz.ks">
    <name>Arthavan Projects</name>
  </developer>
  <description>
    <p>
      Arthavan Projects lists every app in the Craft App Suite (PhotoCraft, LightCraft, FilmCraft,
      DesignCraft, VectorCraft, PdfCraft, EffectCraft, WordCraft, DeckCraft, GridCraft, CADCraft,
      SoundCraft and FigCraft), installs the right build for your computer, and keeps them up to date.
    </p>
    <ul>
      <li>One place to find, install and open every Craft app</li>
      <li>Checks GitHub releases for updates and installs them for you</li>
      <li>Lives in the system tray and tells you when updates are ready</li>
    </ul>
  </description>
  <launchable type="desktop-id">app.freedev.ainz.ks.ArthavanProjects.desktop</launchable>
  <icon type="stock">app.freedev.ainz.ks.ArthavanProjects</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/685ks/craft-launcher</url>
  <url type="bugtracker">https://github.com/685ks/craft-launcher/issues</url>
  <url type="help">https://github.com/685ks/craft-launcher</url>
  <categories>
    <category>Utility</category>
    <category>PackageManager</category>
  </categories>
  <keywords>
    <keyword>launcher</keyword>
    <keyword>installer</keyword>
    <keyword>updater</keyword>
    <keyword>arthavan</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#d9dce3</color>
    <color type="primary" scheme_preference="dark">#26282e</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>arthavan-projects</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
